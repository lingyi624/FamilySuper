@page "/genealogy"
@inject IRepository<FamilyMember> MemberRepo
@inject IRepository<Marriage> MarriageRepo
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudGrid>
    <MudItem xs="12">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5" Class="d-flex align-center gap-2">
                        <span>🏠</span>
                        <span>家庭族谱</span>
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudText Typo="Typo.body2" Class="text-gray-500">展示家庭成员关系图谱</MudText>
                </CardHeaderActions>
            </MudCardHeader>
        </MudCard>
    </MudItem>

    @if (familyTree.Count == 0)
    {
        <MudItem xs="12">
            <MudCard>
                <MudCardContent Class="text-center py-12">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Class="mb-4 text-gray-400" />
                    <MudText Typo="Typo.body1" Class="text-gray-500 mb-4">暂无家庭成员，请先添加</MudText>
                    <MudButton Color="Color.Primary" OnClick="NavigateToFamily" Variant="Variant.Filled">
                        去添加成员
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
    else
    {
        <MudItem xs="12">
            <div class="genealogy-container">
                <svg class="genealogy-svg" ref="svgRef">
                    @foreach (var connection in connections)
                    {
                        <path d="@connection.Path" fill="none" stroke="@connection.Color" stroke-width="2" />
                    }
                </svg>
                <div class="genealogy-tree">
                    @foreach (var root in familyTree)
                    {
                        @RenderFamilyNode(root, 0)
                    }
                </div>
            </div>
        </MudItem>
    }
</MudGrid>

@code {
    private List<FamilyMember> familyTree = new();
    private Dictionary<long, List<FamilyMember>> childrenMap = new();
    private Dictionary<long, FamilyMember> memberMap = new();
    private Dictionary<long, List<Marriage>> marriagesMap = new();
    private List<ConnectionLine> connections = new();
    private ElementReference svgRef;

    private class ConnectionLine
    {
        public string Path { get; set; } = string.Empty;
        public string Color { get; set; } = "#9CA3AF";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFamilyTree();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UpdateConnections();
        }
    }

    private async Task LoadFamilyTree()
    {
        var allMembers = await MemberRepo.GetAllAsync();
        
        memberMap = allMembers.ToDictionary(m => m.Id);

        childrenMap = new Dictionary<long, List<FamilyMember>>();
        foreach (var member in allMembers)
        {
            var children = allMembers.Where(m => m.FatherId == member.Id || m.MotherId == member.Id)
                .OrderBy(c => c.BirthDate)
                .ToList();
            if (children.Any())
            {
                childrenMap[member.Id] = children;
            }
        }

        // 加载婚姻关系
        var allMarriages = await MarriageRepo.GetAllAsync();
        marriagesMap = allMarriages
            .Where(m => !m.IsDeleted)
            .GroupBy(m => m.MemberId)
            .ToDictionary(g => g.Key, g => g.OrderBy(m => m.MarriageOrder).ToList());

        var roots = allMembers
            .Where(m => m.IsTopAncestor)
            .ToList();

        // 去重：如果夫妻双方都是顶级祖辈，只保留一方（男性优先）
        familyTree = new List<FamilyMember>();
        var skipIds = new HashSet<long>();
        foreach (var root in roots.OrderBy(m => m.Gender == Gender.Male ? 0 : 1))
        {
            if (skipIds.Contains(root.Id)) continue;
            familyTree.Add(root);

            // 检查该祖辈的配偶是否也是顶级祖辈
            if (marriagesMap.TryGetValue(root.Id, out var marriages))
            {
                foreach (var m in marriages)
                {
                    if (roots.Any(r => r.Id == m.SpouseId))
                    {
                        skipIds.Add(m.SpouseId);
                        // 将被跳过的配偶的子女合并到当前根节点的子女列表中
                        if (childrenMap.TryGetValue(m.SpouseId, out var spouseChildren))
                        {
                            if (!childrenMap.ContainsKey(root.Id))
                            {
                                childrenMap[root.Id] = new List<FamilyMember>();
                            }
                            foreach (var child in spouseChildren)
                            {
                                if (!childrenMap[root.Id].Any(c => c.Id == child.Id))
                                {
                                    childrenMap[root.Id].Add(child);
                                }
                            }
                            // 合并后按出生日期排序
                            childrenMap[root.Id] = childrenMap[root.Id].OrderBy(c => c.BirthDate).ToList();
                        }
                    }
                }
            }
        }

        if (!familyTree.Any())
        {
            familyTree = allMembers.Take(1).ToList();
        }
    }

    private async Task UpdateConnections()
    {
        connections.Clear();
        
        foreach (var member in memberMap.Values)
        {
            if (member.FatherId.HasValue && memberMap.ContainsKey(member.FatherId.Value))
            {
                connections.Add(new ConnectionLine
                {
                    Path = GetConnectionPath(member.FatherId.Value, member.Id),
                    Color = "#6B7280"
                });
            }
            if (member.MotherId.HasValue && memberMap.ContainsKey(member.MotherId.Value))
            {
                connections.Add(new ConnectionLine
                {
                    Path = GetConnectionPath(member.MotherId.Value, member.Id),
                    Color = "#D97706"
                });
            }
        }

        StateHasChanged();
    }

    private string GetConnectionPath(long parentId, long childId)
    {
        return $"M 0 0 L 30 0";
    }

    private void NavigateToFamily()
    {
        Navigation.NavigateTo("/family");
    }

    private RenderFragment RenderFamilyNode(FamilyMember member, int depth) => __builder =>
    {
        List<FamilyMember>? children = childrenMap.TryGetValue(member.Id, out var kids) ? kids : null;
        var memberMarriages = marriagesMap.TryGetValue(member.Id, out var mrs) ? mrs : new();

        <div class="family-node" id="node-@member.Id">
            <div class="node-left">
                <div class="spouse-row">
                    <div class="member-card">
                        <div class="member-avatar">
                            @if (!string.IsNullOrEmpty(member.AvatarPath) && File.Exists(member.AvatarPath))
                            {
                                <img src="@GetAvatarUrl(member.AvatarPath)" alt="@member.Name" class="avatar-img" />
                            }
                            else
                            {
                                <span class="avatar-emoji">@GetGenderIcon(member)</span>
                            }
                        </div>
                        <div class="member-info">
                            <MudText Typo="Typo.subtitle2" Class="font-bold">@member.Name</MudText>
                            <MudText Typo="Typo.caption" Class="text-gray-500">@member.Role @GetAge(member)</MudText>
                        </div>
                    </div>
                    @foreach (var marriage in memberMarriages)
                    {
                        if (memberMap.TryGetValue(marriage.SpouseId, out var spouseMember))
                        {
                            <div class="spouse-connector">❤️</div>
                            <div class="member-card">
                                <div class="member-avatar">
                                    @if (!string.IsNullOrEmpty(spouseMember.AvatarPath) && File.Exists(spouseMember.AvatarPath))
                                    {
                                        <img src="@GetAvatarUrl(spouseMember.AvatarPath)" alt="@spouseMember.Name" class="avatar-img" />
                                    }
                                    else
                                    {
                                        <span class="avatar-emoji">@GetGenderIcon(spouseMember)</span>
                                    }
                                </div>
                                <div class="member-info">
                                    <MudText Typo="Typo.subtitle2" Class="font-bold">@spouseMember.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="text-gray-500">第@(marriage.MarriageOrder)任 @spouseMember.Role @GetAge(spouseMember)</MudText>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
            
            @if (children != null && children.Count > 0)
            {
                <div class="horizontal-line"></div>
                <div class="children-column">
                    @{
                        var childrenByMother = children
                            .GroupBy(c => c.MotherId)
                            .ToList();
                        var totalGroups = childrenByMother.Count;
                    }
                    @for (int g = 0; g < totalGroups; g++)
                    {
                        var group = childrenByMother[g].ToList();
                        var firstChild = group[0];
                        // 查找该组子女的母亲及婚姻信息
                        string? groupLabel = null;
                        if (firstChild.MotherId.HasValue && memberMap.TryGetValue(firstChild.MotherId.Value, out var motherMember))
                        {
                            var marriage = memberMarriages.FirstOrDefault(m => m.SpouseId == firstChild.MotherId.Value);
                            if (marriage != null)
                            {
                                groupLabel = $"第{marriage.MarriageOrder}任 {motherMember.Name} 所生";
                            }
                            else
                            {
                                groupLabel = $"{motherMember.Name} 所生";
                            }
                        }
                        
                        @if (groupLabel != null)
                        {
                            <div class="marriage-group-label">@groupLabel</div>
                        }
                        
                        @foreach (var child in group)
                        {
                            @RenderFamilyNode(child, depth + 1)
                        }
                        
                        @if (g < totalGroups - 1)
                        {
                            <div class="group-separator"></div>
                        }
                    }
                </div>
            }
        </div>
    };

    private string GetGenderIcon(FamilyMember member)
    {
        return member.Gender switch
        {
            Gender.Male => "👨",
            Gender.Female => "👩",
            _ => "🧑"
        };
    }

    private string GetAge(FamilyMember member)
    {
        if (!member.BirthDate.HasValue) return "";
        var age = DateTime.UtcNow.Year - member.BirthDate.Value.Year;
        return $"({age}岁)";
    }

    private string GetAvatarUrl(string avatarPath)
    {
        if (string.IsNullOrEmpty(avatarPath) || !File.Exists(avatarPath)) return string.Empty;
        
        try
        {
            // 先解析为绝对路径，防止数据库存的是相对路径
            var fullPath = Path.GetFullPath(avatarPath);
            
            var fileInfo = new FileInfo(fullPath);
            // 获取 wwwroot 根目录位置，转换为相对 URL
            var wwwrootRoot = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "wwwroot");
            if (fullPath.StartsWith(wwwrootRoot))
            {
                var relativePath = fullPath.Substring(wwwrootRoot.Length).Replace('\\', '/');
                return $"{relativePath}?t={fileInfo.LastWriteTime.Ticks}";
            }
            // 如果不在 wwwroot 下，降级使用 file:// 协议（绝对路径）
            return $"file:///{fullPath.Replace('\\', '/')}";
        }
        catch
        {
            return string.Empty;
        }
    }
}

<style>
    .genealogy-container {
        position: relative;
        min-height: 400px;
        padding: 40px;
        overflow-x: auto;
    }

    .genealogy-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
    }

    .genealogy-tree {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: center;
    }

    .family-node {
        display: flex;
        flex-direction: row;
        align-items: center;
        position: relative;
        gap: 20px;
    }

    .node-left {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .spouse-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 0px;
    }

    .horizontal-line {
        height: 3px;
        width: 30px;
        background: linear-gradient(to right, #9CA3AF, #6B7280);
        border-radius: 2px;
        position: relative;
    }

    .horizontal-line::before {
        content: '';
        position: absolute;
        top: 50%;
        right: -4px;
        transform: translateY(-50%);
        width: 12px;
        height: 12px;
        background: #9CA3AF;
        border-radius: 50%;
    }

    .children-column {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .marriage-group-label {
        font-size: 13px;
        font-weight: 600;
        color: #D97706;
        padding: 4px 12px;
        background: rgba(217, 119, 6, 0.08);
        border-radius: 6px;
        border-left: 3px solid #D97706;
        margin-bottom: 4px;
        white-space: nowrap;
    }

    .group-separator {
        width: 100%;
        height: 2px;
        background: linear-gradient(to right, transparent, #D1D5DB, transparent);
        margin: 8px 0;
    }

    .member-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 12px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        min-width: 100px;
        color: white;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .member-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }

    .member-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 6px;
        border: 2px solid rgba(255, 255, 255, 0.4);
    }
    
    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .avatar-emoji {
        font-size: 28px;
    }

    .member-info {
        text-align: center;
    }

    .spouse-connector {
        font-size: 16px;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.2); }
    }
</style>