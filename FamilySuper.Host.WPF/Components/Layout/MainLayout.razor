@inherits LayoutComponentBase
@inject Services.ModeStateContainer ModeState

@code {
    private MudTheme _warmTheme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#E8913A",
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#8D6E63",
            Tertiary = "#FFB74D",
            Info = "#7C8B9E",
            Success = "#66BB6A",
            Warning = "#FFA726",
            Error = "#EF5350",
            Dark = "#5D4037",
            DarkContrastText = "#FFFFFF",
            TextPrimary = "#4E342E",
            TextSecondary = "#795548",
            AppbarBackground = "#FF8C42",
            AppbarText = "#FFFFFF",
            DrawerBackground = "#FFF8F3",
            DrawerText = "#4E342E",
            DrawerIcon = "#8D6E63",
            Surface = "#FFF8F3",
            Background = "#FFF3E0",
            Divider = "#FFE0B2",
            TableLines = "#FFE0B2",
            TableHover = "#FFF3E0",
            TableStriped = "#FFF8F3",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Microsoft YaHei", "Segoe UI", "Noto Sans SC", "sans-serif" },
            }
        }
    };

    protected override void OnInitialized()
    {
        ModeState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ModeState.OnChange -= StateHasChanged;
    }
}

<MudThemeProvider Theme="@_warmTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">
    <header class="app-header">
        <div class="app-title">
            <span class="logo">🏠</span>
            <span>家庭超级管家</span>
        </div>
        <div class="header-right">
            <NotificationBell />
            <MudChip T="string" Color="@(ModeState.CurrentMode == AppMode.Adult ? Color.Info : Color.Warning)" Size="Size.Medium">
                @(ModeState.CurrentMode == AppMode.Adult ? "大人模式" : "小孩模式")
            </MudChip>
        </div>
    </header>

    <div class="app-body">
        <nav class="app-nav">
            <NavMenu />
        </nav>

        <main class="app-main">
            @Body
        </main>
    </div>
</div>

<style>
    .app-shell {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: #FFF3E0;
        font-family: "Microsoft YaHei", "Segoe UI", "Noto Sans SC", sans-serif;
    }
    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 24px;
        height: 56px;
        background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
        color: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .app-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 18px;
        font-weight: 600;
    }
    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .logo { font-size: 22px; }
    .app-body {
        display: flex;
        flex: 1;
        overflow: hidden;
    }
    .app-nav {
        width: 220px;
        background: #FFF8F3;
        border-right: 1px solid #FFE0B2;
        padding: 16px 0;
        overflow-y: auto;
    }
    .app-main {
        flex: 1;
        padding: 24px;
        overflow-y: auto;
        background: #FFF3E0;
    }
    /* 灰蓝色点缀 — 用于分隔线、辅助提示等 */
    .accent-line { border-color: #7C8B9E; }
    /* 深色文字提升关键数据可读性 */
    .text-deep { color: #3E2723; font-weight: 500; }
</style>
