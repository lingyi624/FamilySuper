@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms

<MudDialog>
    <DialogContent>
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">上传GLB模型</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body1" Class="mb-4">上传GLB格式的3D模型文件，用于展示虚拟场景。</MudText>
                <div class="mb-4">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Upload" OnClick="TriggerFileUpload">
                        选择GLB文件
                    </MudButton>
                    <InputFile id="@_uploadInputId" class="d-none" accept=".glb,.gltf" OnChange="HandleFileSelected" />
                </div>
                @if (modelData != null)
                {
                    <div class="list-group">
                        <div class="list-group-item d-flex align-items-center">
                            <MudIcon Icon="@Icons.Material.Filled.Translate" Color="Color.Info" Class="mr-2" />
                            <MudText Class="flex-grow-1">@modelData.FileName</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">@(modelData.Data.Length / 1024) KB</MudText>
                        </div>
                    </div>
                }
                @if (isUploading)
                {
                    <MudProgressCircular Size="Size.Medium" Class="mt-4" />
                    <MudText Typo="Typo.caption" Class="text-center mt-2">正在读取文件...</MudText>
                }
            </MudCardContent>
            <MudCardActions>
                <MudButton Color="Color.Primary" OnClick="Upload" Disabled="@(modelData == null || isUploading)" Variant="Variant.Filled">上传</MudButton>
                <MudButton Color="Color.Default" OnClick="Cancel" Disabled="@isUploading">取消</MudButton>
            </MudCardActions>
        </MudCard>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;

    public class UploadModelData
    {
        public string FileName { get; set; } = string.Empty;
        public byte[] Data { get; set; } = Array.Empty<byte>();
    }

    private readonly string _uploadInputId = $"model-upload-{Guid.NewGuid():N}";
    private UploadModelData? modelData;
    private bool isUploading;

    private async Task TriggerFileUpload()
    {
        await JsRuntime.InvokeVoidAsync("triggerFileUpload", _uploadInputId);
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (e.File == null) return;

        isUploading = true;
        StateHasChanged();

        using var stream = e.File.OpenReadStream(50 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        modelData = new UploadModelData
        {
            FileName = e.File.Name,
            Data = ms.ToArray()
        };

        isUploading = false;
        StateHasChanged();
    }

    private void Upload()
    {
        if (modelData != null)
        {
            MudDialog.Close(DialogResult.Ok(modelData));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
